#!/bin/sh
# Fast local gate: formatting plus static analysis. Tests stay in CI and in
# `./gradlew check`, so a commit fails in seconds instead of minutes.
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# gradlew is a POSIX sh script; running it through sh works on Windows too.
if [ -x ./gradlew ]; then
    ./gradlew -q :shared:ktlintCheck :shared:detekt
else
    sh ./gradlew -q :shared:ktlintCheck :shared:detekt
fi
