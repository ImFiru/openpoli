<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The Android entry points live in :shared/androidMain so the shared module owns
      all platform glue. This module only packages the app.
    -->
    <application
        android:name="dev.openpoli.app.OpenPoliApp"
        android:label="OpenPoli"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="dev.openpoli.app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
